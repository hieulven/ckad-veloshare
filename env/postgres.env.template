# Secret: postgres  (StatefulSet `postgres`)
#
# Copy to env/postgres.env and fill in. env/*.env is gitignored and never
# reaches git or Helm — `make secrets` turns this file into the in-cluster
# Secret via `kubectl create secret generic --from-env-file`.
#
# POSTGRES_* are consumed by the postgres image itself. The *_PASSWORD entries
# below are read by the init script (init.sh) when it creates one LOGIN role
# per service, so they must match the DB_PASSWORD in each service's env file.
# Avoid quotes and the ' character — init.sh interpolates these into SQL.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=veloshare

RIDER_PASSWORD=change-me-rider
STATION_PASSWORD=change-me-station
TRIP_PASSWORD=change-me-trip
