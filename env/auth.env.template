# Secret: veloshare-auth  (shared by `rider` and `trip`)
#
# Copy to env/auth.env and fill in. Gitignored; applied by `make secrets`.
#
# rider SIGNS JWTs with JWT_SECRET and trip VERIFIES them with the same value,
# so both read this one Secret — they must not drift apart.
# The admin account lives here rather than in the riders table, so nobody can
# create an admin through the API.
#
# Generate a real secret with:  openssl rand -hex 32

JWT_SECRET=change-me-generate-a-long-random-value
JWT_TTL_SECONDS=3600
ADMIN_EMAIL=admin@veloshare.local
ADMIN_PASSWORD=change-me-admin-password
